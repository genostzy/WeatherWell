{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // The browser loads the service worker by URL string
  // (service-worker-registration.tsx calls register("/sw.js")), so it never
  // appears in the module graph. It is a real entry point, not dead weight.
  "entry": ["public/sw.js"],

  // Vendored shadcn/ui primitives. These are generated by `shadcn add` and
  // kept whole on purpose: trimming the exports we happen not to use today
  // would make every future regeneration a conflict to re-resolve by hand.
  // Their own test stays in the analysis.
  //
  // src/lib/supabase/database.types.ts is generated by the Supabase MCP
  // server's `generate_typescript_types` tool. Only `Database` is imported
  // today; the other exported helper types/const (Tables, TablesInsert,
  // TablesUpdate, Enums, CompositeTypes, Json, Constants) are part of
  // Supabase's standard generated output and are kept whole rather than
  // trimmed, for the same regeneration-conflict reason as the shadcn files.
  //
  // src/test-utils/render-with-data.tsx is the harness every future
  // ReferenceData-consuming component test will use, but it lands in this
  // task before its first consumer (Task 4 converts the mock-data
  // consumers). A test helper can't honestly be made "used" by inventing a
  // caller, so it stays ignored until Task 4 wires one up.
  "ignore": [
    "src/components/ui/*.tsx",
    "!src/components/ui/*.test.tsx",
    "src/lib/supabase/database.types.ts",
    "src/test-utils/render-with-data.tsx"
  ]
}
